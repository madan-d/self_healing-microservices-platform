apiVersion: v1
kind: Secret
metadata:
  name: aiops-secrets
  namespace: aiops
type: Opaque
stringData:
  # OpenAI API Key (optional if using AWS Bedrock or Heuristic fallback)
  OPENAI_API_KEY: ""
  # Slack Incoming Webhook URL for interactive alert cards
  SLACK_WEBHOOK_URL: ""
  # Discord Webhook URL (alternative to Slack)
  DISCORD_WEBHOOK_URL: ""
  # ArgoCD API Token
  ARGOCD_AUTH_TOKEN: ""
